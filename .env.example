# Copy to .env and adjust. Never commit .env.

# Where runtime state lives (synthetic source warehouse + catalog database)
CATALOG_VAR_DIR=var

# ---- AI provider -------------------------------------------------------------
# offline            -> no model calls; deterministic retrieval-only answers (default)
# ollama             -> free local model via Ollama (https://ollama.com)
# openai_compatible  -> any OpenAI-compatible endpoint (e.g. Groq or Gemini free tier)
LLM_PROVIDER=offline

# Ollama (local, free). Install Ollama, then: ollama pull qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# OpenAI-compatible endpoint, for example Groq:
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Request timeout (seconds) and retry attempts for transient errors (timeouts, 429, 5xx)
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2
